{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: debug chatbot",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:api", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "CHATBOT_LOG_LEVEL": "DEBUG" },
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
