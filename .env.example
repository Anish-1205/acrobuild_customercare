# Application
ACROBUILD_ENV=development
ACROBUILD_CORS_ORIGINS=http://localhost:5173
AUTH_SECRET_KEY=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-different-long-random-secret

# Sarvam is the only supported chat provider.
LLM_PROVIDER=sarvam
LLM_HISTORY_TURNS=8

# OpenAI-compatible Sarvam endpoint. RUNPOD_* names are retained for compatibility.
# Set MODEL_NAME to the model ID served by your chosen endpoint.
RUNPOD_BASE_URL=
RUNPOD_API_KEY=
MODEL_NAME=
SARVAM_TIMEOUT_SECONDS=120
SARVAM_DEADLINE_SECONDS=120
SARVAM_MAX_TOKENS=512
SARVAM_REASONING_TOKENS=0

# AcroBuild customer-support API and knowledge sources
ACROBUILD_CS_API_BASE_URL=http://your-cs-api-host:port
ACROBUILD_CS_API_KEY=
ACROBUILD_CS_API_COMPANY_ID=
ACROBUILD_CS_API_TIMEOUT_SECONDS=2.5
ACROBUILD_CS_API_CACHE_TTL_SECONDS=300
ACROBUILD_CS_API_LIVE_ONLY=true
ACROBUILD_COMPANY_DATA_PATH=data/acrobuild_all_company_data.txt
ACROBUILD_SUPPORT_BASE_URL=
ACROBUILD_SUPPORT_TIMEOUT_SECONDS=10
ACROBUILD_SUPPORT_CACHE_TTL_MINUTES=15
ACROBUILD_SUPPORT_MAX_ARTICLES=100
ACROBUILD_REFRESH_INDEX_ON_STARTUP=false
ACROBUILD_WARM_LOCAL_AI_MODELS=false

# Legacy NuFoodz customer context
NUFOODZ_API_BASE_URL=
NUFOODZ_API_TIMEOUT_SECONDS=3
SUPPORT_LLM_CLASSIFICATION=false
ASSIST_FALLBACK_MIN_SCORE=3

# Hugging Face and Indic language models
HF_TOKEN=
HUGGINGFACE_TOKEN=
INDIC_TTS_DEVICE=cpu
INDIC_TTS_MODEL=ai4bharat/indic-parler-tts

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_APP_PASSWORD=

# Observability
LOG_LEVEL=INFO
CHATBOT_LOG_LEVEL=INFO
LIB_LOG_LEVEL=WARNING
LOG_JSON=false
LOG_COLOR=true
LOG_FILE=logs/chatbot.log

# Upload security
CLAMSCAN_PATH=
UPLOAD_STORAGE_QUOTA_BYTES=536870912

# Ollama / Tenglish rewriting
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_TENGLISH_MODEL=gemma-tenglish
GEMMA_TENGLISH_TIMEOUT=120

# Evaluation tooling
EVAL_API_URL=http://127.0.0.1:8000/api/support/assist
EVAL_PROMPTS_PATH=scripts/eval_prompts.json
EVAL_OUTPUT_PATH=customer_support_chatbot_200_prompt_evaluation.xlsx
EVAL_CACHE_PATH=data/chatbot_200_prompt_results.json
EVAL_MAX_WORKERS=4
EVAL_TIMEOUT_SECONDS=60
